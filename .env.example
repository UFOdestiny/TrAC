# Copy to .env and edit. Variables already set in the environment take precedence, and
# relative paths resolve against the repository root. Values are read as plain data
# (no shell expansion); quote values that contain spaces.

# One folder per model, named as in trac/backbones.py (e.g. Qwen3-8B), plus deberta-large-mnli,
# Skywork-Reward-V2-Llama-3.1-8B, Qwen2.5-Math-PRM-7B, and Qwen3-1.7B for the baselines.
MODELS_ROOT=models
# Benchmark mirrors written by scripts/download_data.py.
DATASETS_ROOT=data
# Every cache, score, report, and log.
EXP_ROOT=outputs
# Receives table/*.tex and figures/*.pdf from trac.paper.build (e.g. a LaTeX project).
PAPER_DIR=outputs/paper

# Optional
# PYTHON=/path/to/venv/bin/python      # interpreter used by scripts/*.sh (default: python)
# HF_HOME=/path/to/huggingface/cache   # Hugging Face cache for the dataset download
# QUEUE_START_DELAY=30                 # seconds between queue workers starting on different GPUs
# TRAC_ENV_FILE=/path/to/other.env     # read this file instead of .env (set it in the environment)
