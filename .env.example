# Copy to .env and edit. Relative paths are resolved against the repository root;
# variables already set in the environment take precedence.

# One folder per model, named as in trac/backbones.py (e.g. Qwen3-8B) plus deberta-large-mnli.
MODELS_ROOT=/path/to/models
# Benchmark mirrors written by scripts/download_data.py.
DATASETS_ROOT=data
# Every cache, score, and log (about 2.5 GB for the full matrix).
EXP_ROOT=outputs
# LaTeX project that receives table/*.tex and figures/*.pdf (trac.paper.build).
PAPER_DIR=latex

# Optional
# HF_HOME=/path/to/hf_cache            # HuggingFace cache for the dataset download
# PYTHON=/path/to/env/bin/python       # interpreter used by scripts/*.sh (default: python)
